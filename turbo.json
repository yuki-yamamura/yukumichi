{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["pnpm_config_*"],
  "tasks": {
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "cache": false
    },
    "test:watch": {
      "persistent": true,
      "cache": false
    }
  }
}
