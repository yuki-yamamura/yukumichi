{
  "name": "@yukumichi/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "prettier --check \"./src/**/*.{ts,json,md}\"",
    "format:fix": "prettier --write \"./src/**/*.{ts,json,md}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@yukumichi/eslint": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
