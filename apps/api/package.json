{
  "name": "@yukumichi/api",
  "exports": {
    ".": {
      "types": "./dist/src/app.d.ts",
      "default": "./src/app.ts"
    }
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild --bundle --outfile=./dist/index.js --platform=node --target=node24 --format=cjs --alias:@=./src src/lambda.ts",
    "check-types": "tsc",
    "test": "vitest run",
    "test:small": "vitest run --project small",
    "test:medium": "vitest run --project medium",
    "test:watch": "vitest watch",
    "format": "prettier --check \"./src/**/*.{ts,json,md}\"",
    "format:fix": "prettier --write \"./src/**/*.{ts,json,md}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "knip": "knip --directory ../.. --workspace @yukumichi/api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1079.0",
    "@hono/node-server": "^1.19.11",
    "@hono/standard-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.7.6",
    "@yukumichi/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.1",
    "hono": "catalog:",
    "hono-openapi": "^1.3.0",
    "neverthrow": "^8.2.0",
    "postgres": "^3.4.8",
    "uuidv7": "^1.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "@yukumichi/eslint": "workspace:*",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-drizzle": "^0.2.3",
    "knip": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
