{
  "name": "@sanpo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env production",
    "start": "next start",
    "codegen:cmk": "cmk",
    "check-types": "cmk && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "format": "prettier --check \"./src/**/*.{ts,tsx,css,json,md}\"",
    "format:fix": "prettier --write \"./src/**/*.{ts,tsx,css,json,md}\"",
    "lint": "pnpm run lint:es && pnpm run lint:style",
    "lint:fix": "pnpm run lint:es:fix && pnpm run lint:style:fix",
    "lint:es": "eslint",
    "lint:es:fix": "eslint --fix",
    "lint:style": "stylelint \"./src/**/*.css\"",
    "lint:style:fix": "stylelint --fix \"./src/**/*.css\"",
    "knip": "knip --directory ../.. --workspace @sanpo/web",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sanpo/api": "workspace:*",
    "@sanpo/shared": "workspace:*",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-form-nextjs": "^1.29.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "catalog:",
    "lucide-react": "^1.7.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^1.2.0",
    "@css-modules-kit/stylelint-plugin": "^1.2.0",
    "@faker-js/faker": "catalog:",
    "@opennextjs/cloudflare": "1.19.3",
    "@sanpo/eslint": "workspace:*",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/nextjs-vite": "^10.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@unocss/reset": "^66.6.8",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "babel-plugin-react-compiler": "1.0.0",
    "chromatic": "^16.0.0",
    "eslint": "catalog:",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.10.1",
    "eslint-plugin-storybook": "^10.3.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "knip": "catalog:",
    "playwright": "^1.59.1",
    "prettier": "catalog:",
    "storybook": "^10.3.5",
    "stylelint": "^17.6.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-use-logical": "^2.1.3",
    "stylelint-use-nesting": "^6.0.2",
    "typescript": "catalog:",
    "vite": "^8.0.3",
    "vitest": "catalog:",
    "wrangler": "4.84.1"
  },
  "imports": {
    "#.storybook/preview": "./.storybook/preview.ts"
  }
}
