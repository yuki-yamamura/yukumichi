{
  "name": "@sanpo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env production",
    "start": "next start",
    "codegen:cmk": "cmk",
    "check-types": "cmk && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "format": "prettier --check \"./src/**/*.{ts,tsx,css,json,md}\"",
    "lint": "pnpm run lint:es && pnpm run lint:style",
    "lint:es": "eslint",
    "lint:style": "stylelint \"./src/**/*.css\"",
    "knip": "knip --directory ../.. --workspace @sanpo/web",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@sanpo/api": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.5",
    "lucide-react": "^1.7.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^0.10.0",
    "@faker-js/faker": "catalog:",
    "@opennextjs/cloudflare": "1.17.1",
    "@sanpo/eslint": "workspace:*",
    "@storybook/addon-mcp": "^0.4.2",
    "@storybook/nextjs-vite": "^10.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "catalog:",
    "knip": "catalog:",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-storybook": "^10.3.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "prettier": "catalog:",
    "storybook": "^10.3.3",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9.3",
    "uuidv7": "catalog:",
    "vite": "^8.0.3",
    "vitest": "catalog:",
    "wrangler": "4.69.0"
  }
}
