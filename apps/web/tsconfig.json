{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["vitest/globals"],
    "rootDirs": [".", "generated"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "cmkOptions": {
    "enabled": true,
    "dtsOutDir": "generated"
  },
  "include": [
    "next-env.d.ts",
    "vitest.setup.ts",
    "vitest.d.ts",
    "src",
    ".storybook",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"],
  "references": [{ "path": "../api" }]
}
