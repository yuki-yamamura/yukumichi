{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["prettier", "knip", "cmk"],
  "workspaces": {
    "apps/api": {
      "entry": ["src/server.ts", "src/lambda.ts"]
    },
    "apps/e2e": {
      "entry": ["playwright.config.ts", "usecase/**/*.spec.ts"]
    },
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}", "open-next.config.ts", "!src/app/**/*.test.*"],
      "ignore": ["src/lib/tanstack-form/server-form-state.ts", "src/utils/must-find.ts"],
      "ignoreDependencies": ["@unocss/reset"]
    }
  }
}
